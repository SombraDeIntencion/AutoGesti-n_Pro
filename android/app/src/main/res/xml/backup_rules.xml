<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Incluir preferencias generales INCLUYENDO Firebase Auth -->
    <include domain="sharedpref" path="."/>
    
    <!-- Incluir archivos de la aplicación -->
    <include domain="file" path="."/>
    
    <!-- Incluir base de datos -->
    <include domain="database" path="."/>
    
    <!-- Excluir solo archivos sensibles específicos del backup -->
    <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    <exclude domain="database" path="vehicles.db"/>
    
    <!-- IMPORTANTE: NO excluir com.google.firebase.auth para mantener sesión -->
</full-backup-content>
