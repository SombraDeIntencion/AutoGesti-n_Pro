<?xml version="1.0" encoding="utf-8"?>
<!-- Para Android 12+ (API 31+) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Incluir preferencias generales -->
        <include domain="sharedpref" path="."/>
        
        <!-- Incluir archivos de la aplicación -->
        <include domain="file" path="."/>
        
        <!-- Incluir base de datos -->
        <include domain="database" path="."/>
        
        <!-- Excluir datos sensibles del backup en la nube -->
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
        <exclude domain="database" path="vehicles.db"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Permitir transferencia de datos entre dispositivos -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
